    function searchStatutoryMapper() {
      const query = document.getElementById('mapperSearch').value.toLowerCase().replace(/[^a-z0-9]/g, ' ').trim();
      const tokens = query.split(/\s+/).filter(Boolean);
      const items = document.querySelectorAll('.mapper-item');
      let matchCount = 0;

      items.forEach(item => {
        const keyData = (item.getAttribute('data-keys') + ' ' + item.innerText).toLowerCase();
        if (tokens.length === 0) {
          item.style.display = 'block';
          matchCount++;
          return;
        }
        const isMatch = tokens.every(token => keyData.includes(token));
        item.style.display = isMatch ? 'block' : 'none';
        if (isMatch) matchCount++;
      });

      // If missing in cache, suggest live legal search
      let liveFallbackNotice = document.getElementById('mapperFallbackNotice');
      if (tokens.length > 0 && matchCount === 0) {
        if (!liveFallbackNotice) {
          liveFallbackNotice = document.createElement('div');
          liveFallbackNotice.id = 'mapperFallbackNotice';
          liveFallbackNotice.className = 'card';
          liveFallbackNotice.style.borderLeftColor = 'var(--info-color)';
          document.getElementById('mapperResults').appendChild(liveFallbackNotice);
        }
        liveFallbackNotice.style.display = 'block';
        const qStr = document.getElementById('mapperSearch').value;
        liveFallbackNotice.innerHTML = `
          <span class="card-meta">Live Statutory Fallback</span>
          <h4>Section "${qStr}" not found in local cache</h4>
          <p>Launch live verified lookup across India Code, Supreme Court of India, and Official Gazettes.</p>
          <div style="margin-top:8px;">
            <a href="https://www.google.com/search?q=${encodeURIComponent(qStr + ' site:indiacode.nic.in OR site:sci.gov.in')}" target="_blank" class="dossier-action-btn" style="text-decoration:none;">
              🔍 Search Authentic IndiaCode Repository
            </a>
          </div>
        `;
      } else if (liveFallbackNotice) {
        liveFallbackNotice.style.display = 'none';
      }
    }

