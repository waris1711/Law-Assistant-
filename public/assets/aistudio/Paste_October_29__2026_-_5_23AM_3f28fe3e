<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LEXINTEL | Architect By Waris Irshad</title>
  <style>
    :root {
      --bg-color: #0d0f12;
      --surface-color: #14171c;
      --surface-elevated: #1b1f26;
      --card-bg: #1c2027;
      --card-hover: #242932;
      --text-color: #f1f5f9;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;
      --accent-color: #f59e0b;
      --accent-hover: #d97706;
      --accent-glow: rgba(245, 158, 11, 0.16);
      --border-color: #2b313c;
      --border-light: #3b4252;
      --chip-bg: #21262f;
      --success-color: #10b981;
      --danger-color: #ef4444;
      --info-color: #3b82f6;
      --dossier-page-bg: #111418;
      --dossier-sheet-bg: #161a20;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      padding: 12px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Header */
    .header-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
      gap: 8px;
      flex-wrap: wrap;
    }

    .brand-title {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #fff;
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }

    .brand-sub {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.8px;
      color: var(--accent-color);
      text-transform: uppercase;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .lang-toggle-btn, .header-icon-btn {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--accent-color);
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
    }

    .lang-toggle-btn:hover, .header-icon-btn:hover {
      background: var(--accent-color);
      color: #000;
      border-color: var(--accent-color);
    }

    .profile-badge {
      font-size: 11px;
      color: var(--accent-color);
      background: var(--surface-color);
      padding: 5px 9px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      white-space: nowrap;
      font-weight: 600;
    }

    /* Navigation */
    .nav-tabs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 6px;
      margin-bottom: 12px;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    .nav-tabs::-webkit-scrollbar { display: none; }

    .nav-tab-btn {
      background: var(--surface-color);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      padding: 7px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .nav-tab-btn:active { transform: scale(0.97); }

    .nav-tab-btn.active {
      background: var(--accent-color);
      color: #0b0c0e;
      font-weight: 800;
      border-color: var(--accent-color);
    }

    /* Sub Tabs */
    .sub-tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
      overflow-x: auto;
      white-space: nowrap;
    }
    .sub-tabs::-webkit-scrollbar { display: none; }

    .sub-tab-btn {
      background: var(--surface-color);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 11.5px;
      cursor: pointer;
      font-weight: 600;
    }
    .sub-tab-btn:active { transform: scale(0.97); }
    .sub-tab-btn.active {
      background: var(--surface-elevated);
      color: var(--accent-color);
      border-color: var(--accent-color);
    }

    /* Search & Inputs */
    .search-box {
      width: 100%;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--surface-color);
      color: var(--text-color);
      font-size: 13.5px;
      outline: none;
      margin-bottom: 12px;
      transition: border-color 0.15s ease;
    }
    .search-box:focus { border-color: var(--accent-color); }

    /* Chips */
    .chip-container {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      margin-bottom: 12px;
      padding-bottom: 4px;
      white-space: nowrap;
    }
    .chip-container::-webkit-scrollbar { display: none; }

    .chip {
      background: var(--chip-bg);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .chip:active { transform: scale(0.95); }
    .chip:hover, .chip.active {
      border-color: var(--accent-color);
      color: var(--accent-color);
    }

    /* Cards */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-left: 3px solid var(--accent-color);
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 10px;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
      position: relative;
    }
    .card:hover {
      transform: translateY(-2px);
      background: var(--card-hover);
      border-color: var(--border-light);
    }
    .card:active { transform: scale(0.98); }

    .card h4 {
      font-size: 14px;
      color: var(--text-color);
      margin-bottom: 4px;
      padding-right: 24px;
    }

    .card p {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .card-meta {
      font-size: 10.5px;
      text-transform: uppercase;
      color: var(--accent-color);
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      letter-spacing: 0.5px;
      font-weight: 600;
    }

    .card-bookmark-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: none;
      border: none;
      color: var(--text-subtle);
      font-size: 16px;
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .card-bookmark-btn.saved { color: var(--accent-color); }

    /* Status Badges */
    .badge-status {
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.4px;
    }
    .badge-good { background: rgba(16, 185, 129, 0.15); color: var(--success-color); border: 1px solid var(--success-color); }
    .badge-distinguished { background: rgba(59, 130, 246, 0.15); color: var(--info-color); border: 1px solid var(--info-color); }
    .badge-overruled { background: rgba(239, 68, 68, 0.15); color: var(--danger-color); border: 1px solid var(--danger-color); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* Chatbot Styles */
    .chat-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 12px;
      max-height: 52vh;
      overflow-y: auto;
      padding-right: 4px;
    }
    .chat-container::-webkit-scrollbar { width: 4px; }
    .chat-container::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }

    .chat-bubble {
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 12.5px;
      line-height: 1.55;
    }
    .chat-user {
      background: #242932;
      align-self: flex-end;
      border: 1px solid var(--border-color);
      max-width: 85%;
      color: #fff;
    }
    .chat-ai {
      background: var(--surface-color);
      align-self: flex-start;
      border: 1px solid var(--border-color);
      border-left: 3px solid var(--accent-color);
      max-width: 96%;
    }

    .legal-basis-box {
      background: #0f1115;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 10px 12px;
      margin-top: 8px;
      font-size: 12px;
      line-height: 1.6;
    }
    .legal-basis-box strong { color: var(--accent-color); }

    .chat-input-bar {
      display: flex;
      gap: 6px;
    }

    .chat-send-btn {
      background: var(--accent-color);
      color: #0b0c0d;
      border: none;
      padding: 0 16px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 13px;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .chat-send-btn:active { transform: scale(0.96); }

    /* Dark Themed Dossiers */
    .dossier-wrapper {
      background: var(--dossier-page-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 14px;
    }

    .dossier-top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .dossier-pills {
      display: flex;
      gap: 6px;
      overflow-x: auto;
    }
    .dossier-pills::-webkit-scrollbar { display: none; }

    .dossier-pill {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--accent-color);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }
    .dossier-pill.active {
      background: var(--accent-color);
      color: #000;
      border-color: var(--accent-color);
    }

    .dossier-sheet {
      background: var(--dossier-sheet-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 18px;
      color: var(--text-color);
      box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.4);
    }

    .dossier-header-bar {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .dossier-case-meta {
      font-size: 11.5px;
      color: var(--text-muted);
    }

    .dossier-action-btn {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--accent-color);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .dossier-action-btn:hover { background: #232832; border-color: var(--accent-color); }

    .dossier-heading {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 12px;
      line-height: 1.35;
    }

    .dossier-section-title {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--accent-color);
      margin: 14px 0 6px 0;
      font-weight: 700;
    }

    .dossier-body-text {
      font-size: 12.5px;
      color: #cbd5e1;
      line-height: 1.6;
      background: #0f1216;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    .timeline-node {
      border-left: 2px solid var(--accent-color);
      padding-left: 12px;
      margin-left: 6px;
      margin-top: 8px;
    }

    .timeline-node-item {
      margin-bottom: 8px;
      position: relative;
      font-size: 12px;
    }

    .timeline-node-item::before {
      content: '';
      position: absolute;
      left: -17px;
      top: 5px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-color);
    }

    /* Floating Draggable AI Assistant Pill */
    #draggableAiWidget {
      position: fixed;
      bottom: 24px;
      right: 16px;
      z-index: 999;
      background: linear-gradient(135deg, #242932, #161920);
      border: 1.5px solid var(--accent-color);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 12px var(--accent-glow);
      color: var(--text-color);
      padding: 8px 14px;
      border-radius: 30px;
      cursor: grab;
      user-select: none;
      touch-action: none;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      backdrop-filter: blur(8px);
      transition: box-shadow 0.2s ease, transform 0.05s ease;
    }
    #draggableAiWidget:active { cursor: grabbing; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4); }
    #draggableAiWidget .ai-pulse {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--accent-color);
      box-shadow: 0 0 8px var(--accent-color);
      animation: pulse 1.6s infinite ease-in-out;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Universal Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.82);
      z-index: 1000;
      align-items: flex-end;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }

    .modal-content {
      background: #14171c;
      width: 100%;
      max-width: 660px;
      max-height: 85vh;
      border-radius: 14px 14px 0 0;
      border: 1px solid var(--border-color);
      padding: 16px;
      overflow-y: auto;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
      animation: slideUp 0.2s ease-out;
    }
    @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 8px;
      gap: 8px;
    }

    .modal-title {
      font-size: 15px;
      color: var(--accent-color);
      font-weight: 700;
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 24px;
      cursor: pointer;
      line-height: 0.8;
      padding: 2px;
    }

    .modal-body h5 {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--accent-color);
      margin: 10px 0 4px 0;
      font-weight: 700;
    }

    .modal-body p {
      font-size: 12px;
      color: var(--text-color);
      line-height: 1.55;
      background: var(--surface-color);
      padding: 8px 10px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    /* Bookmarks Drawer & Note Box */
    .note-textarea {
      width: 100%;
      background: #0f1216;
      border: 1px solid var(--border-color);
      color: #fff;
      padding: 8px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
      resize: vertical;
      min-height: 60px;
      margin-top: 6px;
    }
    .note-textarea:focus { border-color: var(--accent-color); }
  </style>
</head>
