      document.getElementById('modalTitle').innerText = art.title;
      document.getElementById('modalDynamicBody').innerHTML = `
        <div style="margin-bottom:8px;">
          <span style="font-size:11px; color:var(--accent-color); font-weight:700;">PART:</span> ${art.part} | 
          <span style="font-size:11px; color:var(--text-muted);">Article ${art.no}</span>
        </div>
        <h5>Bare Act Provision / Text</h5>
        <p>${art.bareAct}</p>
        <h5>Key Landmark Precedents</h5>
        <p>${art.cases}</p>
        <h5>Judicial Examination & Analytical Notes</h5>
        <p>${art.notes}</p>
        <div style="margin-top:10px; display:flex; justify-content:space-between; align-items:center;">
          <a href="https://www.google.com/search?q=${encodeURIComponent(art.title + ' site:indiacode.nic.in')}" target="_blank" class="dossier-action-btn" style="text-decoration:none;">Official IndiaCode Link ➔</a>
          <button class="dossier-action-btn" onclick="openFeedbackModalFor('${escapeHtml(art.title)}')">⚠️ Report Issue</button>
        </div>
      `;
      document.getElementById('detailModal').classList.add('open');
    }

    function openCaseModal(id) {
      triggerHaptic();
      const c = CASES_DB.find(item => item.id === id);
      if (!c) return;

      document.getElementById('modalTitle').innerText = c.title;
      document.getElementById('modalDynamicBody').innerHTML = `
        <div style="margin-bottom:8px;">
          <span style="font-size:11px; color:var(--accent-color); font-weight:700;">Citation:</span> ${c.citation} | 
          <span style="font-size:11px; color:var(--text-muted);">${c.bench}</span>
