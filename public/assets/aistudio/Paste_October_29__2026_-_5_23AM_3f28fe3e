    // ==========================================
    // 8. BOOKMARKS & PERSONAL NOTES (STORAGE)
    // ==========================================
    function getStoredBookmarks() {
      try {
        return JSON.parse(localStorage.getItem('lexintel_bookmarks') || '[]');
      } catch(e) { return []; }
    }

    function saveStoredBookmarks(arr) {
      try {
        localStorage.setItem('lexintel_bookmarks', JSON.stringify(arr));
      } catch(e) {}
      updateBookmarkCounter();
    }

    function isBookmarked(type, id) {
      const bks = getStoredBookmarks();
      return bks.some(b => b.type === type && b.id === id);
    }

    function updateBookmarkCounter() {
      const count = getStoredBookmarks().length;
      document.getElementById('bookmarkCount').innerText = count;
    }

    function toggleBookmark(e, type, id, title, summary) {
      e.stopPropagation();
      triggerHaptic();
      let bks = getStoredBookmarks();
      const idx = bks.findIndex(b => b.type === type && b.id === id);

      if (idx > -1) {
        bks.splice(idx, 1);
        e.target.classList.remove('saved');
      } else {
        bks.push({ type, id, title, summary, note: '', date: new Date().toLocaleDateString() });
        e.target.classList.add('saved');
      }
      saveStoredBookmarks(bks);
    }

    function openBookmarksDrawer() {
      triggerHaptic();
      const libTabBtn = Array.from(document.querySelectorAll('.nav-tabs .nav-tab-btn'))
        .find(b => b.innerText.includes('Bookmarks') || b.innerText.includes('Mehfooz'));
      if (libTabBtn) switchTab('libraryTab', libTabBtn);
    }

    function renderBookmarksList() {
      const container = document.getElementById('bookmarksContainer');
      const bks = getStoredBookmarks();

      if (bks.length === 0) {
        container.innerHTML = `<p style="color: var(--text-muted); font-size: 13px;">No bookmarks saved yet. Tap the bookmark icon (🔖) on any card or case to save here with custom notes.</p>`;
        return;
      }

      container.innerHTML = bks.map((item, idx) => `
        <div class="card" style="cursor:default;">
          <div class="card-meta">
            <span>Saved: ${item.date} • ${item.type.toUpperCase()}</span>
            <button onclick="removeBookmark(${idx})" style="background:none; border:none; color:var(--danger-color); cursor:pointer; font-size:12px; font-weight:700;">Remove</button>
          </div>
          <h4 style="color:var(--accent-color);">${item.title}</h4>
          <p>${item.summary}</p>
          <div style="margin-top:8px;">
            <label style="font-size:11px; text-transform:uppercase; color:var(--text-muted); font-weight:700;">Student Legal Notes:</label>
            <textarea class="note-textarea" placeholder="Add personal case brief, trial argument notes, or exam pointers..." onchange="updateBookmarkNote(${idx}, this.value)">${item.note || ''}</textarea>
          </div>
        </div>
      `).join('');
    }

    function updateBookmarkNote(index, text) {
      const bks = getStoredBookmarks();
      if (bks[index]) {
        bks[index].note = text;
        saveStoredBookmarks(bks);
      }
    }

    function removeBookmark(index) {
      triggerHaptic();
      const bks = getStoredBookmarks();
      bks.splice(index, 1);
      saveStoredBookmarks(bks);
      renderBookmarksList();
      // Update card buttons on other pages
      document.querySelectorAll('.card-bookmark-btn').forEach(btn => btn.classList.remove('saved'));
      bks.forEach(b => {
        document.querySelectorAll(`.card-bookmark-btn`).forEach(btn => {
          if (btn.getAttribute('onclick')?.includes(`'${b.id}'`)) btn.classList.add('saved');
        });
      });
    }

    function exportBookmarks() {
      triggerHaptic();
      const bks = getStoredBookmarks();
      const blob = new Blob([JSON.stringify(bks, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Lexintel_Legal_Notes_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    // ==========================================
    // 9. USER FEEDBACK & ERROR REPORTING MODAL
    // ==========================================
    function openFeedbackModal() {
      triggerHaptic();
      document.getElementById('reportSubject').value = '';
      document.getElementById('reportDetails').value = '';
      document.getElementById('feedbackModal').classList.add('open');
    }

    function openFeedbackModalFor(subject) {
      triggerHaptic();
      closeModalDirect();
      document.getElementById('reportSubject').value = `Correction: ${subject}`;
      document.getElementById('reportDetails').value = '';
      document.getElementById('feedbackModal').classList.add('open');
    }

    function closeFeedbackModalDirect() {
      triggerHaptic();
      document.getElementById('feedbackModal').classList.remove('open');
    }

    function closeFeedbackModal(e) {
      if (e.target.id === 'feedbackModal') closeFeedbackModalDirect();
    }

    function submitUserFeedback() {
      triggerHaptic();
      const subj = document.getElementById('reportSubject').value.trim();
      const det = document.getElementById('reportDetails').value.trim();
      if (!subj || !det) {
        alert("Please enter subject and description of the citation or provision issue.");
        return;
      }
      alert(`Report submitted successfully for "${subj}". Waris Irshad Architect Desk will review and update statutory records.`);
      closeFeedbackModalDirect();
    }

