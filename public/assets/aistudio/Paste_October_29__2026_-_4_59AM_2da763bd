  <script>
    // Global Language State
    let currentLang = 'en';

    function toggleLanguage() {
      currentLang = currentLang === 'en' ? 'ur' : 'en';
      document.getElementById('langBtnText').innerText = currentLang === 'en' ? 'Roman Urdu' : 'English';

      // Update all elements containing data-en and data-ur attributes
      const translatables = document.querySelectorAll('[data-en][data-ur]');
      translatables.forEach(el => {
        el.innerText = el.getAttribute(`data-${currentLang}`);
      });

      // Update search placeholders
      const searchInputs = {
        'constMainSearch': currentLang === 'en' ? 'Search Article no., schedule, amendment, fundamental rights...' : 'Article number, schedule ya amendment talash karein...',
        'aiQueryInput': currentLang === 'en' ? 'Ask: e.g., Kya police bina warrant arrest kar sakti hai?' : 'Poochiye: Maslan, Kya police bina warrant arrest kar sakti hai?',
        'caseSearchInput': currentLang === 'en' ? 'Search by Act, Section, Case Name, Citation or Issue...' : 'Act, Section, Case ka naam ya issue talash karein...',
        'mapperSearch': currentLang === 'en' ? 'Search Section number or title (e.g. 102, 302, 420, 167)...' : 'Section number ya title talash karein (e.g. 102, 302, 420)...',
        'ratioSearch': currentLang === 'en' ? 'Search precedents, ratio decidendi, doctrines...' : 'Adalati nazeer, faisle ki buniyad talash karein...',
        'glossarySearch': currentLang === 'en' ? 'Search Latin maxims, legal terms, principles...' : 'Latin maxims aur qanooni istilaahaat talash karein...'
      };

      for (const [id, ph] of Object.entries(searchInputs)) {
        const input = document.getElementById(id);
        if (input) input.placeholder = ph;
      }
    }

    // Tab Navigation
    function switchTab(tabId, btnElement) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-tab-btn').forEach(el => el.classList.remove('active'));

      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
      if (btnElement) btnElement.classList.add('active');
    }

    // Constitution Sub-tab Switcher
    function switchConstSubTab(viewId) {
      document.getElementById('constArticlesView').style.display = 'none';
      document.getElementById('constSchedulesView').style.display = 'none';
      document.getElementById('constAmendmentsView').style.display = 'none';

      document.querySelectorAll('.sub-tab-btn').forEach(btn => btn.classList.remove('active'));

      document.getElementById(viewId).style.display = 'block';

      if (viewId === 'constArticlesView') document.getElementById('subBtnArticles').classList.add('active');
      if (viewId === 'constSchedulesView') document.getElementById('subBtnSchedules').classList.add('active');
      if (viewId === 'constAmendmentsView') document.getElementById('subBtnAmendments').classList.add('active');
    }

    // Modal Handlers
    function closeModalDirect() {
      document.getElementById('detailModal').classList.remove('open');
    }

    function closeDetailModal(e) {
      if (e.target.id === 'detailModal') closeModalDirect();
    }

    function showArticleModal(title, bareAct, cases, notes) {
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalDynamicBody').innerHTML = `
        <h5>Bare Act Provision / Summary</h5>
        <p>${bareAct}</p>
        <h5>Key Landmark Precedents</h5>
        <p>${cases}</p>
        <h5>Judicial & Exam Examination Notes</h5>
        <p>${notes}</p>
      `;
      document.getElementById('detailModal').classList.add('open');
    }

    function showCaseModal(title, citation, bench, statute, facts, issue, ratio, paras, status) {
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalDynamicBody').innerHTML = `
        <div style="margin-bottom: 8px;">
          <span style="font-size:11.5px; color: var(--accent-color); font-weight:700;">Citation:</span> ${citation} | 
          <span style="font-size:11.5px; color: var(--text-muted);">${bench}</span>
        </div>
        <h5>Applicable Statute & Sections</h5>
        <p>${statute}</p>
        <h5>Factual Matrix</h5>
        <p>${facts}</p>
        <h5>Core Legal Issue</h5>
        <p>${issue}</p>
        <h5>Ratio Decidendi (Binding Principle)</h5>
        <p><strong>${ratio}</strong></p>
        <h5>Verified Paragraphs & Status</h5>
        <p>Paragraphs: ${paras}<br>Status: <strong>${status}</strong></p>
      `;
      document.getElementById('detailModal').classList.add('open');
    }

    // Unified Constitution Filter
    function filterConstitutionSearch() {
      const q = document.getElementById('constMainSearch').value.toLowerCase().trim();
      const activeView = document.querySelector('#constitution > div[style*="block"]') || document.getElementById('constArticlesView');
      const cards = activeView.querySelectorAll('.const-card');

      cards.forEach(card => {
        const text = (card.innerText + ' ' + (card.getAttribute('data-keys') || '')).toLowerCase();
        card.style.display = text.includes(q) ? 'block' : 'none';
      });
    }

    function filterByPart(partName, chipElement) {
      const chips = chipElement.parentElement.querySelectorAll('.chip');
      chips.forEach(c => c.classList.remove('active'));
      chipElement.classList.add('active');

      const cards = document.querySelectorAll('#articlesList .const-card');
      cards.forEach(card => {
        const part = card.getAttribute('data-part') || '';
        card.style.display = (partName === 'ALL' || part === partName) ? 'block' : 'none';
      });
    }

    // Case Law Filter
    function filterCases() {
      const q = document.getElementById('caseSearchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.case-card');
      cards.forEach(card => {
        const text = (card.innerText + ' ' + card.getAttribute('data-tags')).toLowerCase();
        card.style.display = text.includes(q) ? 'block' : 'none';
      });
    }

    function fillCaseSearch(term) {
      const input = document.getElementById('caseSearchInput');
      input.value = term;
      filterCases();
    }

    // Statutory Mapper Search (Matches embedded dictionary reliably)
    function searchStatutoryMapper() {
      const query = document.getElementById('mapperSearch').value.toLowerCase().replace(/[^a-z0-9]/g, ' ').trim();
      const tokens = query.split(/\s+/).filter(Boolean);
      const items = document.querySelectorAll('.mapper-item');

      items.forEach(item => {
        const keyData = (item.getAttribute('data-keys') + ' ' + item.innerText).toLowerCase();
        if (tokens.length === 0) {
          item.style.display = 'block';
          return;
        }
        const isMatch = tokens.every(token => keyData.includes(token));
        item.style.display = isMatch ? 'block' : 'none';
      });
    }

    function quickFillMapper(val) {
      const searchBox = document.getElementById('mapperSearch');
      searchBox.value = val;
      searchStatutoryMapper();
    }

    // Generic filter for cards
    function filterSectionCards(inputId, containerId) {
      const query = document.getElementById(inputId).value.toLowerCase().trim();
      const container = document.getElementById(containerId);
      const cards = container.getElementsByClassName('card');

      Array.from(cards).forEach(card => {
        const text = card.innerText.toLowerCase();
        card.style.display = text.includes(query) ? 'block' : 'none';
      });
    }

    // Lexintel AI "Ask Law" logic
    function askPreset(question) {
      document.getElementById('aiQueryInput').value = question;
      handleAskLaw();
    }

    function handleAskLaw() {
      const input = document.getElementById('aiQueryInput');
      const query = input.value.trim();
      if (!query) return;

      const chatArea = document.getElementById('chatArea');

      // User Bubble
      const userBubble = document.createElement('div');
      userBubble.className = 'chat-bubble chat-user';
      userBubble.innerText = query;
      chatArea.appendChild(userBubble);
      input.value = '';

      // AI Response with statutory basis
      setTimeout(() => {
        const aiBubble = document.createElement('div');
        aiBubble.className = 'chat-bubble chat-ai';
        const qLower = query.toLowerCase();

        if (qLower.includes('arrest') || qLower.includes('warrant')) {
          aiBubble.innerHTML = `
            <strong>Statutory Legal Position:</strong><br>
            Police can arrest without a warrant <strong>only in cognizable offences</strong> or under express conditions specified by statute. In non-cognizable offences, an arrest warrant issued by a competent Magistrate is legally mandatory.
            
            <div class="legal-basis-box">
              <strong>1. Applicable Law:</strong> Code of Criminal Procedure, 1973 / Bharatiya Nagarik Suraksha Sanhita, 2023.<br>
              <strong>2. Statutory Section:</strong> Section 41 CrPC ➔ Section 35 BNSS.<br>
              <strong>3. Mandatory Conditions:</strong> For offences punishable with imprisonment up to 7 years, arrest cannot be routine. Police must satisfy necessity parameters (preventing further crime, tampering with evidence, threatening witnesses) and record written reasons.<br>
              <strong>4. Statutory Exceptions:</strong> Section 41A CrPC [Sec 35(3) BNSS] mandates notice of appearance where arrest is not strictly necessary.<br>
              <strong>5. Leading Citation:</strong> <em>Arnesh Kumar v. State of Bihar (2014) 8 SCC 273</em>.<br>
              <strong>⚠️ Insufficient Facts Notice:</strong> If the nature of offence (cognizable or non-cognizable) and maximum prescribed imprisonment are unspecified, absolute legality cannot be adjudicated.
            </div>
          `;
        } else if (qLower.includes('default bail') || qLower.includes('167') || qLower.includes('187')) {
          aiBubble.innerHTML = `
            <strong>Statutory Legal Position:</strong><br>
            Default bail is an indefeasible fundamental right under Article 21 when the investigative agency fails to file a police report (chargesheet) within the statutory limitation period.
            
            <div class="legal-basis-box">
              <strong>1. Relevant Provision:</strong> Section 167(2) CrPC ➔ Section 187(2)-(3) BNSS.<br>
              <strong>2. Statutory Remand Timelines:</strong> 90 days (offences punishable with death, life imprisonment, or minimum 10 years imprisonment) or 60 days (all other offences).<br>
              <strong>3. Binding Ratio:</strong> Right accrues immediately upon expiry of the period and cannot be frustrated by subsequent filings. (<em>Bikramjit Singh v. State of Punjab 2020</em>).
            </div>
          `;
        } else if (qLower.includes('confession') || qLower.includes('police')) {
          aiBubble.innerHTML = `
            <strong>Statutory Legal Position:</strong><br>
            A confession made to a police officer is strictly inadmissible against an accused person in criminal proceedings.
            
            <div class="legal-basis-box">
              <strong>1. Relevant Law:</strong> Indian Evidence Act, 1872 / Bharatiya Sakshya Adhiniyam, 2023.<br>
              <strong>2. Statutory Section:</strong> Section 25 & 26 IEA ➔ Section 22 & 23 BSA.<br>
              <strong>3. Statutory Exception:</strong> Section 27 IEA [Sec 23(2) BSA] allows admissibility strictly limited to the recovery of a distinct physical fact or object discovered pursuant to information received from the accused.
            </div>
          `;
        } else {
          aiBubble.innerHTML = `
            <strong>Legal Analysis Received:</strong> "${query}"<br>
            <div class="legal-basis-box">
              <strong>Statutory Overview:</strong> Cross-referencing under relevant penal, procedural, or constitutional regimes.<br>
              <strong>⚠️ Insufficient Facts Notice:</strong> Legal conclusions require the specific subject matter (e.g. penal section, civil dispute, or writ jurisdiction) to eliminate speculative responses and cite verified bare act sections.
            </div>
          `;
        }

        chatArea.appendChild(aiBubble);
        chatArea.scrollTop = chatArea.scrollHeight;
      }, 300);
    }
  </script>
</body>
</html>
