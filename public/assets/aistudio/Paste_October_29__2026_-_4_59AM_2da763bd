      border: 1px solid var(--border-color);
    }

    /* Calculation / Box helper */
    .stat-box {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 12px;
    }
  </style>
</head>
