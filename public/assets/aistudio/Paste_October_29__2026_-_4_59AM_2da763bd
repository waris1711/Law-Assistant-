    /* Universal Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.78);
      z-index: 1000;
      align-items: flex-end;
      justify-content: center;
    }

    .modal-overlay.open {
      display: flex;
