    <div class="sub-tabs">
      <button class="sub-tab-btn active" id="subBtnArticles" onclick="switchConstSubTab('constArticlesView')" data-en="Articles (1–395 Directory)" data-ur="Dafaat (1–395 Directory)">Articles (1–395 Directory)</button>
