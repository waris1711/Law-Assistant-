    .modal-title {
      font-size: 16px;
      color: var(--accent-color);
      font-weight: 800;
      line-height: 1.35;
    }

    .close-btn {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 20px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      flex-shrink: 0;
      transition: all 0.15s ease;
    }
    .close-btn:hover {
      background: var(--danger-color);
      color: #fff;
      border-color: var(--danger-color);
    }

    .modal-body h5 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--accent-color);
      margin: 14px 0 5px 0;
      font-weight: 700;
    }

    .modal-body p {
      font-size: 13px;
