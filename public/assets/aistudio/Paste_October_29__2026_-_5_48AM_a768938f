        'caseSearchInput': currentLang === 'en' ? 'Search by Act, Section, Case Name, Citation or Legal Issue...' : 'Act, Section, Case ka naam ya issue talash karein...',
        'mapperSearch': currentLang === 'en' ? 'Enter ANY Section (e.g. 102, 103, 302, 420, 167, 41)...' : 'Section number darj karein (e.g. 102, 103, 302)...',
        'ratioSearch': currentLang === 'en' ? 'Search precedents, ratio decidendi, doctrines...' : 'Adalati nazeer, faisle ki buniyad talash karein...',
        'glossarySearch': currentLang === 'en' ? 'Search Latin maxims, legal terms, principles...' : 'Latin maxims aur qanooni istilaahaat talash karein...'
      };

