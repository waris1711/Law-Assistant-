      line-height: 1.6;
      background: #0d1015;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    .note-textarea {
      width: 100%;
      background: #0a0c10;
      border: 1px solid var(--border-color);
      color: #fff;
      padding: 10px;
      border-radius: 6px;
      font-size: 12.5px;
      outline: none;
      resize: vertical;
      min-height: 65px;
      margin-top: 6px;
    }
    .note-textarea:focus { border-color: var(--accent-color); }

    /* Draggable Floating AI Assistant Widget */
    #draggableAiWidget {
      position: fixed;
      bottom: 24px;
      right: 16px;
      z-index: 99999;
      background: linear-gradient(135deg, #1f242d, #12151b);
      border: 1.5px solid var(--accent-color);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.75), 0 0 14px var(--accent-glow);
      color: var(--text-color);
      padding: 9px 16px;
      border-radius: 35px;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      font-weight: 800;
      backdrop-filter: blur(10px);
      transition: box-shadow 0.2s ease;
    }
    #draggableAiWidget:active {
      cursor: grabbing;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.45);
    }
    #draggableAiWidget .voice-wave-icon {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      height: 12px;
    }
    #draggableAiWidget .voice-bar {
      width: 3px;
      height: 10px;
      background: var(--accent-color);
      border-radius: 2px;
      animation: voiceBarWave 1.2s infinite ease-in-out;
    }
    #draggableAiWidget .voice-bar:nth-child(2) { animation-delay: 0.2s; height: 14px; }
    #draggableAiWidget .voice-bar:nth-child(3) { animation-delay: 0.4s; height: 8px; }

    @keyframes voiceBarWave {
      0%, 100% { transform: scaleY(0.6); }
      50% { transform: scaleY(1.3); }
    }
  </style>
</head>
