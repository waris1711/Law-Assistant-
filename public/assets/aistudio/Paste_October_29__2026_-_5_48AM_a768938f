    .dossier-pills::-webkit-scrollbar { display: none; }

    .dossier-pill {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      color: var(--accent-color);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }
    .dossier-pill.active {
      background: var(--accent-color);
      color: #000;
      border-color: var(--accent-color);
